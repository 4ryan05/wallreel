# Copy to .env.local and fill in. With the Supabase values empty, the site runs in demo mode.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Reddit API app for syncing posts ("script" type at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:wallreel:1.0 (by /u/your_reddit_username)

# Reddit app for "Continue with Reddit" ("web app" type, redirect URI https://YOUR-SITE/auth/reddit/callback)
REDDIT_LOGIN_CLIENT_ID=
REDDIT_LOGIN_CLIENT_SECRET=

# Shared secret for /api/cron/sync (any long random string)
CRON_SECRET=
